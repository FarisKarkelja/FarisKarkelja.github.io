---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Terminal from '../components/Terminal.astro';
import { DEFAULT_THEME } from '../data/themes';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const dev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en" class:list={[{ dev }]} data-theme={DEFAULT_THEME}>
  <head>
    <BaseHead title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Terminal />
    <script>
      import { initSmoothScroll } from '../scripts/motion';
      initSmoothScroll();
    </script>
  </body>
</html>
