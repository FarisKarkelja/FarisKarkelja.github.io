---
import { getCollection } from 'astro:content';
import { profile, toolkit } from '../data/profile';
import { themes } from '../data/themes';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    tagline: p.data.tagline,
    url: p.data.caseStudy ? `/work/${p.id}/` : (p.data.links.live ?? p.data.links.repo ?? p.data.links.extra[0]?.url ?? '/work/'),
  }));

const data = {
  name: profile.name,
  summary: profile.summary,
  status: profile.status,
  email: profile.email,
  github: profile.socials.github,
  linkedin: profile.socials.linkedin,
  cvPdf: profile.cvPdf,
  projects,
  skills: toolkit.slice(0, 5).map((g) => ({ group: g.group, items: g.items.map((i) => i.name) })),
  themes: themes.map((t) => ({ id: t.id, note: t.note })),
};
---

<dialog class="terminal" data-terminal aria-labelledby="terminal-title">
  <div class="terminal__frame tty" data-terminal-frame>
    <div class="terminal__bar">
      <span class="terminal__dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <h2 id="terminal-title" class="terminal__title">faris@sarajevo: ~</h2>
      <button class="terminal__close" type="button" data-terminal-close aria-label="Close the terminal">esc</button>
    </div>
    <div class="terminal__screen" data-terminal-screen>
      <div class="terminal__out" data-terminal-out aria-live="polite"></div>
      <form class="terminal__form" data-terminal-form autocomplete="off">
        <label for="terminal-input" class="terminal__prompt">faris@sarajevo:~$</label>
        <span class="terminal__field">
          <span class="terminal__ghost" aria-hidden="true"><span data-ghost-typed></span><span data-ghost-rest></span></span>
          <input id="terminal-input" class="terminal__input" data-terminal-input type="text" spellcheck="false" autocapitalize="off" autocomplete="off" enterkeyhint="go" aria-describedby="terminal-tip" />
        </span>
      </form>
    </div>
    <div class="terminal__foot">
      <div class="terminal__chips" aria-label="Suggested commands">
        {['help', 'status', 'work', 'theme', 'contact', 'cv'].map((c) => <button type="button" data-terminal-chip={c}>{c}</button>)}
      </div>
      <p class="terminal__tip" id="terminal-tip">Tab completes</p>
    </div>
  </div>
  <script type="application/json" data-terminal-data set:html={JSON.stringify(data)} />
</dialog>

<style is:global>
  /* The shared "tty" look: the hero status card and the terminal are the same machine. */
  .tty {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--phosphor) 28%, transparent);
    border-radius: 12px;
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--phosphor) 7%, transparent), transparent 60%),
      color-mix(in srgb, var(--tty-bg) 88%, transparent);
    color: var(--phosphor);
    font-family: var(--mono);
    text-shadow: 0 0 8px color-mix(in srgb, var(--phosphor) 32%, transparent);
    overflow: hidden;
  }
  /* CRT scanlines */
  .tty::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0) 0 2px, rgb(0 0 0 / 0.2) 2px 3px);
    mix-blend-mode: multiply;
  }
  .tty .tty-cmd {
    color: var(--text);
    text-shadow: none;
  }
  .tty .tty-dim {
    color: color-mix(in srgb, var(--phosphor) 62%, transparent);
  }
  .tty .tty-ok {
    color: var(--signal);
    text-shadow: 0 0 8px color-mix(in srgb, var(--signal) 35%, transparent);
  }
  ::view-transition-group(tty) {
    animation-duration: 0.42s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  ::view-transition-old(tty),
  ::view-transition-new(tty) {
    height: 100%;
    object-fit: fill;
  }
</style>

<style>
  .terminal {
    width: min(780px, calc(100vw - 1.5rem));
    max-height: min(640px, calc(100dvh - 1.5rem));
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .terminal::backdrop {
    background: color-mix(in srgb, var(--bg-deep) 74%, transparent);
    backdrop-filter: blur(6px);
  }
  .terminal[open] {
    animation: term-in 0.35s var(--ease-out);
  }
  @keyframes term-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }
  }
  .terminal__frame {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    border-radius: 14px;
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--phosphor) 7%, transparent), transparent 60%),
      var(--tty-bg);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 30px 80px -20px rgb(0 0 0 / 0.8),
      0 0 60px -10px color-mix(in srgb, var(--phosphor) 20%, transparent);
  }
  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, var(--phosphor) 16%, transparent);
  }
  .terminal__dots {
    display: flex;
    gap: 0.4rem;
  }
  .terminal__dots i {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--phosphor) 45%, transparent);
  }
  .terminal__title {
    flex: 1;
    font: 500 0.8rem/1 var(--mono);
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--phosphor) 70%, transparent);
    text-align: center;
  }
  .terminal__close {
    position: relative;
    z-index: 1;
    font: 0.75rem/1 var(--mono);
    color: color-mix(in srgb, var(--phosphor) 80%, transparent);
    background: none;
    border: 1px solid color-mix(in srgb, var(--phosphor) 30%, transparent);
    border-radius: 4px;
    padding: 0.35rem 0.5rem;
    cursor: pointer;
  }
  .terminal__screen {
    flex: 1;
    min-height: 15rem;
    overflow-y: auto;
    padding: 1rem 1.1rem 1.1rem;
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .terminal__out :global(p) {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .terminal__out :global(a) {
    color: var(--signal);
  }
  .terminal__out :global(.gap) {
    height: 0.6rem;
  }
  .terminal__form {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin-top: 0.4rem;
  }
  .terminal__prompt {
    color: var(--text);
    text-shadow: none;
    white-space: nowrap;
  }
  .terminal__field {
    position: relative;
    flex: 1;
    min-width: 0;
  }
  .terminal__ghost {
    position: absolute;
    inset: 0;
    white-space: pre;
    overflow: hidden;
    pointer-events: none;
    color: color-mix(in srgb, var(--phosphor) 42%, transparent);
    text-shadow: none;
  }
  .terminal__ghost [data-ghost-typed] {
    visibility: hidden;
  }
  .terminal__input {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--phosphor);
    font: inherit;
    caret-color: var(--phosphor);
    text-shadow: inherit;
  }
  .terminal__input:focus-visible {
    outline: none;
  }
  .terminal__foot {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem 0.8rem;
    border-top: 1px solid color-mix(in srgb, var(--phosphor) 16%, transparent);
  }
  .terminal__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .terminal__chips button {
    font: 0.78rem/1 var(--mono);
    color: color-mix(in srgb, var(--phosphor) 90%, transparent);
    background: color-mix(in srgb, var(--phosphor) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--phosphor) 24%, transparent);
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    cursor: pointer;
    text-shadow: none;
  }
  .terminal__chips button:hover {
    background: color-mix(in srgb, var(--phosphor) 14%, transparent);
  }
  .terminal__tip {
    margin: 0;
    font-size: 0.72rem;
    white-space: nowrap;
    color: color-mix(in srgb, var(--phosphor) 50%, transparent);
    text-shadow: none;
  }
  @media (max-width: 560px) {
    .terminal__prompt {
      font-size: 0.72rem;
    }
    .terminal__screen {
      font-size: 0.8rem;
    }
    .terminal__tip {
      display: none;
    }
  }
</style>

<script>
  import { initTerminal } from '../scripts/terminal';
  initTerminal();
</script>
