---
import Icon from '../Icon.astro';
import { profile } from '../../data/profile';

// The status card types itself once: the command first, then each line of output.
const KEY = 13;
const prompt = 'faris@sarajevo:~$ status';
let t = 250;
const cmd = { n: prompt.length, d: t, ms: prompt.length * 26 };
t += cmd.ms + 180;
const rows = profile.status.map((row) => {
  const n = KEY + (row.live ? 2 : 0) + row.value.length;
  const r = { ...row, n, d: t, ms: Math.max(90, n * 5) };
  t += 130;
  return r;
});
const cols = Math.max(cmd.n + 8, ...rows.map((r) => r.n));
const end = t + 120;

// The line above the buttons: a fixed start, then what I build, rotating every few seconds.
const builds = ['web apps, end to end.', 'websites for real clients.', 'REST APIs and databases.', 'interfaces everyone can use.'];
---

<section class="hero" aria-labelledby="hero-name">
  <canvas class="hero__field" data-signal-field aria-hidden="true"></canvas>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__inner container">
    <h1 class="hero__name" id="hero-name">
      <span class="hero__line"><span>{profile.firstName}</span></span>
      <span class="hero__line hero__line--2"><span>{profile.lastName}</span></span>
      <span class="visually-hidden">, full-stack software engineer</span>
    </h1>

    <div class="hero__bottom">
      <div class="hero__left">
      <p class="hero__role">
        <span class="hero__role-fixed">Full-stack software engineer.</span>
        <span class="hero__role-line">I build <span class="hero__rot" data-rot aria-hidden="true">{builds.map((b, i) => <span class:list={{ 'is-on': i === 0 }}>{b}</span>)}</span><span class="visually-hidden">{builds.join(' ')}</span></span>
      </p>
      <div class="hero__ctas">
        <a class="btn btn--accent" href="#work">See my work</a>
        <a class="btn" href={profile.cvPdf} download>
          <Icon name="download" />
          Download CV
        </a>
      </div>
      </div>

      <div class="status tty" data-tty-card style={`--cols: ${cols}; --end: ${end}ms`}>
        <div class="status__lines">
          <p class="status__row tty-cmd" style={`--n: ${cmd.n}; --delay: ${cmd.d}ms; --ms: ${cmd.ms}ms`}>{prompt}</p>
          {rows.map((r) => (
            <p class="status__row" style={`--n: ${r.n}; --delay: ${r.d}ms; --ms: ${r.ms}ms`}><span class="tty-dim">{r.key.padEnd(KEY)}</span>{r.live && <Fragment><i class="status__dot" />{' '}</Fragment>}{r.value}</p>
          ))}
          <p class="status__row status__row--idle tty-cmd">{'faris@sarajevo:~$ '}<span class="status__caret" aria-hidden="true" /></p>
        </div>
        <kbd class="status__hint" data-kbd-hint aria-hidden="true">Ctrl K</kbd>
        <button class="status__open" type="button" data-terminal-open aria-haspopup="dialog">
          <span class="visually-hidden">Open the terminal</span>
        </button>
      </div>
    </div>
  </div>

  <a class="hero__cue" href="#about" aria-label="Scroll to About">
    <span aria-hidden="true">5</span><span aria-hidden="true">6</span><span aria-hidden="true">7</span><span aria-hidden="true">8</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(4.5rem, 3rem + 4vw, 7rem);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }
  .hero__field.is-ready {
    opacity: 1;
  }
  /* shown before WebGL loads, and the only background if it never does */
  .hero__glow {
    position: absolute;
    inset: auto -10% -30% -10%;
    height: 75%;
    z-index: -2;
    background:
      radial-gradient(50% 60% at 50% 100%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(30% 40% at 70% 90%, color-mix(in srgb, var(--signal) 7%, transparent), transparent 70%);
  }
  .hero__name {
    font-size: var(--display);
    line-height: 0.82;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 48;
    font-weight: 400;
    margin-left: -0.05em;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.26em;
  }
  .hero__line:first-child {
    margin-bottom: -0.26em;
  }
  .hero__line > span {
    display: inline-block;
  }
  .hero__line--2 {
    padding-left: 0.9em;
  }
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }
  .hero__left {
    display: grid;
    gap: clamp(1.4rem, 1rem + 1vw, 2rem);
  }
  .hero__role {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1rem + 1.1vw, 2rem);
    line-height: 1.3;
    font-variation-settings: 'opsz' 36;
    color: var(--text-dim);
  }
  .hero__role-fixed {
    display: block;
    color: var(--text);
  }
  .hero__role-line {
    display: block;
    white-space: nowrap;
  }
  .hero__rot {
    display: inline-grid;
    font-style: italic;
    color: var(--accent-bright);
  }
  .hero__rot > span {
    grid-area: 1 / 1;
    opacity: 0;
    translate: 0 0.5em;
    transition:
      opacity 0.45s var(--ease-out),
      translate 0.6s var(--ease-out);
  }
  .hero__rot > span.is-on {
    opacity: 1;
    translate: 0 0;
  }
  .hero__rot > span.is-out {
    opacity: 0;
    translate: 0 -0.5em;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ---------- status card (looks like the terminal, opens the terminal) ---------- */
  .status {
    flex: none;
    font-size: clamp(0.58rem, 2.95vw, 0.84rem);
    line-height: 1.75;
    padding: 0.95em 1.15em 1em;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .status:hover,
  .status:focus-within {
    border-color: color-mix(in srgb, var(--phosphor) 60%, transparent);
    box-shadow: 0 0 40px -12px color-mix(in srgb, var(--phosphor) 40%, transparent);
  }
  .status__lines {
    width: calc(var(--cols) * 1ch);
  }
  .status__row {
    margin: 0;
    width: calc(var(--n) * 1ch);
    white-space: pre;
    overflow: hidden;
    animation: type var(--ms) steps(var(--n)) var(--delay) both;
  }
  .status__row--idle {
    width: auto;
    animation: appear 1ms linear var(--end) both;
  }
  @keyframes type {
    from {
      width: 0;
    }
  }
  @keyframes appear {
    from {
      visibility: hidden;
    }
  }
  .status__dot {
    display: inline-block;
    width: 1ch;
    height: 1ch;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 10px var(--signal);
    scale: 0.8;
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  .status__caret {
    display: inline-block;
    width: 0.6em;
    height: 1.05em;
    vertical-align: -0.16em;
    background: var(--phosphor);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .status__hint {
    position: absolute;
    top: 0.9em;
    right: 1em;
    font-size: 0.82em;
    color: color-mix(in srgb, var(--phosphor) 70%, transparent);
    border-color: color-mix(in srgb, var(--phosphor) 30%, transparent);
    text-shadow: none;
  }
  .status__open {
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 0;
    border-radius: inherit;
    background: none;
    cursor: pointer;
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    translate: -50% 0;
    display: flex;
    gap: 0.9rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--muted);
    text-decoration: none;
  }
  .hero__cue span {
    animation: count 2.4s infinite;
  }
  .hero__cue span:nth-child(2) {
    animation-delay: 0.3s;
  }
  .hero__cue span:nth-child(3) {
    animation-delay: 0.6s;
  }
  .hero__cue span:nth-child(4) {
    animation-delay: 0.9s;
  }
  @keyframes count {
    0%,
    30%,
    100% {
      color: var(--muted);
    }
    10% {
      color: var(--accent-bright);
    }
  }
  @media (max-width: 900px) {
    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .hero__line--2 {
      padding-left: 0.45em;
    }
  }
  @media (max-width: 560px) {
    .hero__role-line {
      white-space: normal;
    }
    .hero {
      justify-content: center;
      padding-bottom: 3.5rem;
    }
    .hero__cue {
      display: none;
    }
    .status {
      line-height: 1.85;
    }
    .status__hint {
      display: none;
    }
  }
  @media (hover: none) {
    .status__hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status__row,
    .status__row--idle {
      animation: none;
    }
  }
</style>

<script>
  // Load Three.js only after the text is on screen, so the field never delays the content.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-signal-field]');
  const start = () =>
    import('../../scripts/signal-field')
      .then((m) => canvas && m.initSignalField(canvas))
      .catch(() => {
        /* no WebGL: the CSS glow stays */
      });
  const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1200 }) : setTimeout(cb, 300));
  // rotate the "I build ..." line; reduced motion keeps the first one
  const rot = document.querySelector('[data-rot]');
  if (rot && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = [...rot.children];
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      const prev = items[i];
      i = (i + 1) % items.length;
      prev.classList.replace('is-on', 'is-out');
      setTimeout(() => prev.classList.remove('is-out'), 650);
      items[i].classList.add('is-on');
    }, 2800);
  }
  if (canvas) {
    if (document.readyState === 'complete') idle(start);
    else window.addEventListener('load', () => idle(start), { once: true });
  }
</script>
