---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Devices from '../../components/Devices.astro';
import Icon from '../../components/Icon.astro';
import { getShots } from '../../lib/shots';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  const studies = all.filter((p) => p.data.caseStudy);
  return studies.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: studies[(i + 1) % studies.length] },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const shots = getShots(project.id);
const links = [
  ...(data.links.live ? [{ label: 'Visit the live site', url: data.links.live }] : []),
  ...(data.links.repo ? [{ label: 'View the code', url: data.links.repo }] : []),
  ...data.links.extra,
];
---

<Base title={`${data.title}, ${data.tagline}`} description={data.summary}>
  <article class="study">
    <header class="study__head container">
      <div class="study__intro">
        <p class="study__back"><a class="link" href="/work/">All projects</a></p>
        <h1 class="study__title">{data.title}</h1>
        <p class="study__tagline">{data.tagline}</p>
        {
          links.length > 0 && (
            <ul class="study__links">
              {links.map((l, i) => (
                <li>
                  <a class:list={['btn', { 'btn--accent': i === 0 }]} href={l.url} target="_blank" rel="noopener">
                    {l.label}
                    <Icon name="external" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {data.links.note && <p class="study__note">{data.links.note}</p>}
      </div>
      <div class="study__mock">
        <Devices slugs={[project.id]} titles={[data.title]} eager sizes="(max-width: 900px) 92vw, 50vw" />
      </div>
    </header>

    <div class="container">
      <dl class="study__spec">
        <div><dt>Role</dt><dd>{data.role}</dd></div>
        <div><dt>Context</dt><dd>{data.context}</dd></div>
        <div><dt>Year</dt><dd>{data.year}</dd></div>
        {data.stack.length > 0 && <div class="study__spec-wide"><dt>Stack</dt><dd>{data.stack.join(', ')}</dd></div>}
      </dl>
    </div>

    <div class="study__body container">
      <aside class="study__aside">
        <p class="study__summary">{data.summary}</p>
        {
          data.highlights.length > 0 && (
            <ul class="study__highlights">
              {data.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )
        }
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    {
      shots.extra.length > 0 && (
        <div class="study__gallery container">
          {shots.extra.map((img) => (
            <figure>
              <Image src={img} alt={`${data.title} screenshot`} widths={[700, 1100]} sizes="(max-width: 900px) 96vw, 48vw" loading="lazy" />
            </figure>
          ))}
        </div>
      )
    }

    <nav class="study__next container" aria-label="Next project">
      <a href={`/work/${next.id}/`}>
        <span class="study__next-label">Next project</span>
        <span class="study__next-title">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .study__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: center;
    padding-top: calc(var(--header-h) + 3rem);
  }
  .study__back {
    margin-bottom: 1.6rem;
    font-size: 0.95rem;
  }
  .study__back a {
    color: var(--text-dim);
  }
  .study__title {
    font-size: clamp(2.8rem, 1.2rem + 4.4vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variation-settings: 'opsz' 48;
    margin-left: -0.04em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .study__tagline {
    margin: 1.4rem 0 0;
    font-size: var(--step-2);
    color: var(--text-dim);
    max-width: 30rem;
    line-height: 1.3;
  }
  .study__links {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .study__note {
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-family: var(--serif);
    font-style: italic;
  }
  .study__mock {
    background: radial-gradient(60% 55% at 50% 45%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 75%);
  }
  .study__spec {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: clamp(2rem, 1rem + 3vw, 4rem) 0 0;
    border-top: 1px solid var(--rule);
  }
  .study__spec div {
    padding: 1rem 1.5rem 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .study__spec-wide {
    grid-column: 1 / -1;
  }
  .study__spec dt {
    color: var(--muted);
    font-size: 0.88rem;
    margin-bottom: 0.25rem;
  }
  .study__spec dd {
    margin: 0;
  }
  .study__body {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .study__aside {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 1.6rem;
  }
  .study__summary {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1.4;
  }
  .study__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .study__highlights li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--text-dim);
  }
  .study__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.6rem;
    height: 1px;
    background: var(--accent);
  }
  .prose {
    max-width: var(--measure);
    color: var(--text-dim);
  }
  .prose :global(h2) {
    font-size: var(--step-3);
    color: var(--text);
    margin: 2.8rem 0 1rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2rem;
    margin: 0 0 1.2rem;
  }
  .prose :global(li + li) {
    margin-top: 0.4rem;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(em) {
    font-family: var(--serif);
  }
  .study__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: 1.25rem;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .study__gallery figure {
    margin: 0;
  }
  .study__gallery :global(img) {
    width: 100%;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--rule);
  }
  .study__next {
    margin-block: clamp(4rem, 3rem + 5vw, 8rem);
    border-top: 1px solid var(--rule);
  }
  .study__next a {
    display: grid;
    gap: 0.4rem;
    padding-top: 2.5rem;
    text-decoration: none;
  }
  .study__next-label {
    color: var(--muted);
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-1);
  }
  .study__next-title {
    font-family: var(--serif);
    font-size: var(--step-5);
    line-height: 1;
    transition: color 0.25s;
  }
  .study__next a:hover .study__next-title {
    color: var(--accent-bright);
  }
  @media (max-width: 900px) {
    .study__head,
    .study__body {
      grid-template-columns: 1fr;
    }
    .study__aside {
      position: static;
    }
    .study__spec {
      grid-template-columns: 1fr;
    }
  }
</style>
